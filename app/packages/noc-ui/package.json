{
  "name": "@donorlin/noc-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Night of Chances UI platform library: opinionated React components, forms, tables and patterns built on Radix UI, TanStack Table and react-hook-form + zod, with documentation for humans and AI agents in docs/.",
  "license": "MIT",
  "author": "donorlin",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run check:types && npm run lint && npm test && npm run check:docs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/parkinsans": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
